@dataclass
class _RunContext:
    spark: Any
    root_path: str
    stage_name: str
    model_name: str
    experiment_id: str
    base_output_dir: Path


def load_class(class_path: str):
    module_path, class_name = class_path.split(":")
    module = importlib.import_module(module_path)
    return getattr(module, class_name)


def _handle_train_test_split(
    ctx: _RunContext, cls, func_conf: dict, func_kwargs: dict
) -> None:
    target_type = func_kwargs.get("target_data_type")
    target_info = func_kwargs["outputs"]["file"]
    source_type = func_kwargs["source_data_type"]
    data_ops = cls(
        spark=ctx.spark,
        func_conf=func_conf,
        source_type=source_type,
        root_path=ctx.root_path,
        stage_name=ctx.stage_name,
        experiment_id=ctx.experiment_id,
    )
    result = data_ops.split_data()
    merged_df, train_df, test_df, feature_params = (
        result["merged"],
        result["train"],
        result["test"],
        result["params"],
    )

    if feature_params:
        logger.debug(feature_params)
        mlflow.log_param(key="features_info", value=json.dumps(feature_params))

    if target_type == "file":
        # TODO: output should always be csv, but we can extend this later
        for key, df in [("merged", merged_df), ("train", train_df), ("test", test_df)]:
            rel = target_info[key].lstrip("/")
            out_dir = ctx.base_output_dir / "/".join(rel.split("/")[:-1])
            out_dir.mkdir(parents=True, exist_ok=True)
            out_path = ctx.base_output_dir / rel
            logger.info(f"Writing {key} data output to {out_dir}")
            mlflow.log_param(key=f"target_{key}_file_path", value=out_path)
            df.to_csv(out_path, index=False)


def _handle_hyperparameter_tuning(ctx: _RunContext, cls, func_kwargs: dict) -> None:
    source_info = func_kwargs["inputs"]["file"]
    train_data_path = ctx.base_output_dir / source_info["train"]["data"].lstrip("/")
    train_df = pd.read_csv(filepath_or_buffer=train_data_path, sep=",")

    hyper_obj = cls(train_df=train_df)
    tuning_results = hyper_obj.run()
    for mname, result in tuning_results.items():
        with mlflow.start_run(
            run_name=f"{mname}_hyperopt",
            experiment_id=ctx.experiment_id,
            nested=True,
        ):
            mlflow.log_params(params=result["best_params"])
            mlflow.log_metric(key="best_loss", value=result["best_loss"])

            for idx, trial in enumerate(result["trials"], start=1):
                with mlflow.start_run(
                    run_name=f"{mname}_trial_{idx}",
                    experiment_id=ctx.experiment_id,
                    nested=True,
                ):
                    mlflow.log_params(params=trial["params"])
                    mlflow.log_metrics(metrics=trial["metrics"])
                    mlflow.log_metric(key="loss", value=trial["loss"])
                    mlflow.set_tag(key="status", value=trial["status"])

    tuning_results_path = (
        ctx.base_output_dir / "models" / ctx.model_name / "hyperparameter_results.json"
    )
    tuning_results_path.parent.mkdir(parents=True, exist_ok=True)
    with open(tuning_results_path, "w") as f:
        json.dump(tuning_results, f, indent=2)
    mlflow.log_artifact(local_path=str(tuning_results_path))


def _handle_model_evaluation(ctx: _RunContext, cls, func_kwargs: dict) -> None:
    source_info = func_kwargs["inputs"]["file"]
    train_data_path = ctx.base_output_dir / source_info["train"]["data"].lstrip("/")
    train_df = pd.read_csv(filepath_or_buffer=train_data_path, sep=",")

    # TODO: read from hyper results from experiment not from the bundle path
    tuning_results_path = (
        ctx.base_output_dir / "models" / ctx.model_name / "hyperparameter_results.json"
    )
    if not tuning_results_path.exists():
        raise FileNotFoundError("Hyperparameter tuning results not found")

    with open(tuning_results_path) as f:
        tuning_results = json.load(f)

    evaluator = cls(train_df=train_df, tuning_results=tuning_results)
    evaluation_results = evaluator.run()
    for mname, result in evaluation_results["models"].items():
        with mlflow.start_run(
            run_name=f"{mname}_evaluation",
            experiment_id=ctx.experiment_id,
            nested=True,
        ):
            mlflow.log_params(params=result["best_params"])
            mlflow.log_metrics(metrics=result["mean_metrics"])

            for fold in result["folds"]:
                with mlflow.start_run(
                    run_name=f"{mname}_fold_{fold['fold']}",
                    experiment_id=ctx.experiment_id,
                    nested=True,
                ):
                    fold_metrics = {k: v for k, v in fold.items() if k != "fold"}
                    mlflow.log_metrics(metrics=fold_metrics)

    mlflow.log_param(key="best_model", value=evaluation_results["best_model"])
    mlflow.log_param(
        key="selection_metric", value=evaluation_results["selection_metric"]
    )
    mlflow.log_param(key="selection_value", value=evaluation_results["selection_value"])
    mlflow.set_tag(key="status", value="success")

    best_model_name = evaluation_results["best_model"]
    best_model_params = {
        best_model_name: evaluation_results["models"][best_model_name]["best_params"]
    }
    best_model_params_path = (
        ctx.base_output_dir / "models" / ctx.model_name / "best_model_params.json"
    )
    best_model_params_path.parent.mkdir(parents=True, exist_ok=True)
    with open(best_model_params_path, "w") as f:
        json.dump(best_model_params, f, indent=2)
    mlflow.log_artifact(local_path=str(best_model_params_path))


def _handle_model_training(
    ctx: _RunContext, cls, func_conf: dict, func_kwargs: dict
) -> str:
    source_info = func_kwargs["inputs"]["file"]
    train_df = pd.read_csv(
        filepath_or_buffer=ctx.base_output_dir
        / source_info["train"]["data"].lstrip("/"),
        sep=",",
    )
    test_df = pd.read_csv(
        filepath_or_buffer=ctx.base_output_dir
        / source_info["test"]["data"].lstrip("/"),
        sep=",",
    )

    # TODO: read from best_model_params results from experiment not from the bundle path
    if ctx.stage_name == "retraining":
        best_model_params_path = (
            Path(ctx.root_path)
            / "training"
            / "models"
            / ctx.model_name
            / "best_model_params.json"
        )
    else:
        best_model_params_path = (
            ctx.base_output_dir / "models" / ctx.model_name / "best_model_params.json"
        )
    if not best_model_params_path.exists():
        raise FileNotFoundError("Best model results not found")

    with open(best_model_params_path) as f:
        best_model_params = json.load(f)

    best_model_name = next(iter(best_model_params.keys()))
    best_params = best_model_params[best_model_name]
    trainer = cls(
        train_df=train_df,
        test_df=test_df,
        model_name=best_model_name,
        best_params=best_params,
    )
    model_results = trainer.run()

    with mlflow.start_run(
        run_name="train_metrics", experiment_id=ctx.experiment_id, nested=True
    ):
        mlflow.log_metrics(model_results["metrics"]["train"])

    with mlflow.start_run(
        run_name="test_metrics", experiment_id=ctx.experiment_id, nested=True
    ):
        mlflow.log_metrics(model_results["metrics"]["test"])

    artifacts_dir = ctx.base_output_dir / "models" / ctx.model_name / "model_artifacts"
    artifacts_dir.mkdir(parents=True, exist_ok=True)

    params_path = artifacts_dir / "best_model_params.json"
    with open(params_path, "w") as f:
        json.dump(best_model_params, f, indent=2)
    mlflow.log_artifact(local_path=str(params_path))

    X_sample = model_results["input_example"]
    y_sample = model_results["model"].predict(X_sample)
    signature = infer_signature(model_input=X_sample, model_output=y_sample)

    # Dynamically discover what types are in the model
    with tempfile.NamedTemporaryFile(suffix=".skops", delete=False) as tmp:
        tmp_path = tmp.name
    sio.dump(model_results["model"], tmp_path)
    trusted_types = sio.get_untrusted_types(file=tmp_path)
    os.unlink(tmp_path)

    # Bundle the DS package source with the model so the serving container
    # does not need to pip-install it from PyPI (it is a private package).
    _spec = _ilu.find_spec("{{ ds_project }}")
    if _spec and _spec.submodule_search_locations:
        _code_paths = [str(Path(next(iter(_spec.submodule_search_locations))))]
    else:
        logger.warning("{{ ds_project }} not installed; code_paths will be empty.")
        _code_paths = []

    # Use pip list --local to get only the job env packages (avoids duplicates
    # when the cluster base env and job env expose different package versions).
    _freeze = _subprocess.run(
        [sys.executable, "-m", "pip", "list", "--format=freeze", "--local"],
        capture_output=True,
        text=True,
        check=False,
    )
    _PRIVATE_PKGS = {
        "{{ ds_project | replace('_', '-') }}",
        "{{ project | replace('_', '-') }}",
        "ds-cli",
        "mlops-cli",
    }
    _pip_reqs = [
        r
        for r in _freeze.stdout.splitlines()
        if r
        and "==" in r
        and r.lower().split("==")[0].replace("_", "-") not in _PRIVATE_PKGS
    ]

    model_info = mlflow.sklearn.log_model(
        sk_model=model_results["model"],
        artifact_path="model",
        signature=signature,
        input_example=X_sample,
        skops_trusted_types=trusted_types,
        code_paths=_code_paths,
        pip_requirements=_pip_reqs,
    )
    model_reg_info = mlflow.register_model(
        model_uri=model_info.model_uri,
        name=func_kwargs["model_registry_name"],
    )
    model_registered_version = model_reg_info.version
    logger.info(
        f"Registered model: {model_reg_info.name} with version: {model_registered_version}"
    )
    MlflowClient().set_registered_model_alias(
        name=func_kwargs["model_registry_name"],
        alias="challenger",
        version=model_registered_version,
    )
    logger.info(
        f"Set @challenger alias on {model_reg_info.name} v{model_registered_version}"
    )

    scaler_path = artifacts_dir / "scaler.pkl"
    joblib.dump(model_results["scaler"], scaler_path)
    mlflow.log_artifact(local_path=scaler_path, artifact_path="model/scaler")
    mlflow.log_param(key="scalar", value=scaler_path)

    features_base_path = ctx.base_output_dir / "data" / "featurization"
    feature_files = sorted(features_base_path.rglob("*_features.pkl"))

    if feature_files:
        feature_files_relative = [
            str(path.relative_to(ctx.base_output_dir)) for path in feature_files
        ]
        logger.info(
            f"Found feature files in {features_base_path}: {feature_files_relative}"
        )
        features_metadata = {
            feature_file.stem.replace("_features", ""): feature_file.relative_to(
                ctx.base_output_dir
            ).as_posix()
            for feature_file in feature_files
        }
        mlflow.log_param(key="feature_pipelines", value=json.dumps(features_metadata))
        for feature_file in feature_files:
            mlflow.log_artifact(
                local_path=str(feature_file), artifact_path="model/featurization/"
            )
    else:
        logger.warning(f"No *_features.pkl files found in {features_base_path}")

    if func_kwargs.get("include_model_explainability", False):
        logger.info("Generating model explainability plots...")
        model_explain(
            model=model_results["model"],
            train_data=model_results["X_train"],
            test_data=model_results["X_test"],
            file_name=str(artifacts_dir / "feature_importance.png"),
            file_name1=str(artifacts_dir / "global_feature_importance.png"),
            file_name2=str(artifacts_dir / "local_feature_importance.png"),
            file_name3=str(artifacts_dir / "individual_explainability.png"),
        )
        for plot_file in [
            "feature_importance.png",
            "global_feature_importance.png",
            "local_feature_importance.png",
            "individual_explainability.png",
        ]:
            mlflow.log_artifact(
                local_path=artifacts_dir / plot_file,
                artifact_path="model/explainability/",
            )

    return model_registered_version


def main(spark):
    parser = argparse.ArgumentParser()

    parser.add_argument("--root_path", required=True)
    parser.add_argument("--runtime_env", required=True)
    parser.add_argument("--yml_task", required=True)
    parser.add_argument("--project_name", required=True)
    parser.add_argument("--model_name", required=True)
    parser.add_argument("--stage_name", required=True)
    parser.add_argument("--task_key", required=True)
    parser.add_argument("--task_run_id", required=True)
    parser.add_argument("--job_name", required=True)
    parser.add_argument("--job_id", required=True)
    parser.add_argument("--job_run_id", required=True)
    parser.add_argument("--experiment_id", required=True)

    args = parser.parse_args()
    root_path = args.root_path
    runtime_env = args.runtime_env.lower()
    yml_task = args.yml_task
    project_name = args.project_name
    model_name = args.model_name
    stage_name = args.stage_name
    task_key = args.task_key
    task_run_id = args.task_run_id
    job_name = args.job_name
    job_id = args.job_id
    job_run_id = args.job_run_id
    experiment_id = args.experiment_id

    env_context = load_project_config(project_name=project_name, env_name=runtime_env)

    task_config = load_task_config(
        project_name=project_name,
        model_name=model_name,
        stage_name=stage_name,
        env_context=env_context,
        which_file=yml_task,
    )
    placeholder_audit_table = f"hive_metastore.default.mlops_{project_name}_audit_tbl"
    audit_table = task_config.get("audit_table", placeholder_audit_table)
    if audit_table.startswith("."):
        logger.warning("`AUDIT_TARGET_CATALOG` is not specified in `config.toml`.")
        logger.info("Saving the audit details in `hive_metastore`.")
        audit_table = placeholder_audit_table

    model_registered_version = None

    with mlflow.start_run(
        run_name=f"{model_name}_training" if model_name != "none" else "training",
        experiment_id=experiment_id,
        nested=True,
    ):
        actions_config = task_config.get("actions", [])
        for action in actions_config:
            if not action.get("enable", True):
                continue

            action_name = action["name"]
            func_conf = action["functions"]
            process_name = func_conf["kwargs"]["process_name"]
            cls = load_class(func_conf["class_path"])

            logger.info(f"Starting action: {action_name}")

            start_time = datetime.now(tz=timezone.utc)
            run_status = ""
            error_details = ""

            workspace_url = env_context["WORKSPACE_URL"].rstrip("/")
            run_url = f"{workspace_url}/#job/{job_id}/run/{job_run_id}"
            env_name_notify = runtime_env.upper()

            base_output_dir = Path(os.path.join(root_path, stage_name))
            ctx = _RunContext(
                spark=spark,
                root_path=root_path,
                stage_name=stage_name,
                model_name=model_name,
                experiment_id=experiment_id,
                base_output_dir=base_output_dir,
            )

            with mlflow.start_run(
                run_name=action_name, experiment_id=experiment_id, nested=True
            ):
                try:
                    func_kwargs = func_conf["kwargs"]

                    if action_name == "train_test_split":
                        model_registered_version = None
                        _handle_train_test_split(ctx, cls, func_conf, func_kwargs)

                    elif action_name == "hyperparameter_tuning":
                        model_registered_version = None
                        _handle_hyperparameter_tuning(ctx, cls, func_kwargs)

                    elif action_name == "model_evaluation":
                        model_registered_version = None
                        _handle_model_evaluation(ctx, cls, func_kwargs)

                    elif action_name == "model_training":
                        model_registered_version = _handle_model_training(
                            ctx, cls, func_conf, func_kwargs
                        )

                    elif action_name == "log_experiment_details":
                        cls(
                            spark=spark,
                            experiment_id=experiment_id,
                            model_name=model_name,
                            stage_name=stage_name,
                            func_conf=func_conf,
                        )

                    run_status = "SUCCESS"
                except Exception as e:
                    run_status = "FAILED"
                    error_details = str(e)[:500]
                    logger.error(f"Action failed: {action_name}")
                    send_gchat_failure(
                        webhook_url=env_context["WEBHOOK_URL"],
                        environment=env_name_notify,
                        project=project_name,
                        task=task_key,
                        job_name=job_name,
                        error_message=error_details,
                        run_url=run_url,
                    )
                    raise

                finally:
                    end_time = datetime.now(tz=timezone.utc)
                    duration_minutes = round(
                        (end_time - start_time).total_seconds() / 60, 2
                    )
                    mlflow.log_metric("duration_minutes", duration_minutes)
                    mlflow.set_tag("run_status", run_status)

                    audit_metrics = {
                        "project_name": project_name,
                        "model_name": model_name,
                        "stage_name": stage_name,
                        "task_name": task_key,
                        "process_name": process_name,
                        "task_run_id": task_run_id,
                        "job_name": job_name,
                        "job_id": job_id,
                        "job_run_id": job_run_id,
                        "run_status": run_status,
                        "start_time": str(start_time),
                        "end_time": str(end_time),
                        "duration_mins": str(duration_minutes),
                        "error_details": error_details,
                    }
                    logger.info(
                        f"Action {action_name} finished | Status={run_status} | Duration={duration_minutes} min"
                    )
                    write_to_audit_table(spark, audit_metrics, func_conf, audit_table)

    logger.success("Data splitting/Model training completed successfully.")
    return experiment_id, model_name, model_registered_version


if __name__ == "__main__":
    spark = SparkSession.builder.getOrCreate()
    dbutils = DBUtils(spark) if DBUtils is not None else None

    experiment_id, model_name, model_registered_version = main(spark=spark)
    if dbutils is not None:
        dbutils.jobs.taskValues.set(key="experiment_id", value=experiment_id)
        dbutils.jobs.taskValues.set(key=model_name, value=model_registered_version)
