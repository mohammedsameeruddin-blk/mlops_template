actions:
  - name: {{ dataset_keyword }}_featurization
    enable: true
    functions:
      class_path:
      kwargs:
        project_name: {{ project }}
        process_name: {{ dataset_keyword }}_features
        source_data_type: file
        target_data_type: file
        experiment_details: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.experiment_tracking"
        inputs:
          # currently supports file/databricks_table
          file:
            data: /data/preprocessing/{{ dataset_keyword }}_incoming.csv
            pipeline: {{ dataset_keyword }}_features.pkl # refers to the pkl file that was saved during training
          databricks_table:
        outputs:
          # currently supports file/databricks_table
          file:
            data: /data/featurization/{{ dataset_keyword }}_incoming.csv
            pipeline: /data/featurization/{{ dataset_keyword }}_features.pkl
          databricks_table:
            feature_store: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.{{ dataset_keyword }}_incoming_features"
            primary_key: "{{ dataset_keyword }}_id" # change as per the requirement