[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project }}"
version = "1.0.0"
description = "MLOps provisioner for data science projects"
readme = "README.md"
requires-python = ">=3.10"

authors = [
    { name = "mlops.team@blackstraw.ai" }
]

# IMPORTANT: Only include pure-Python libs here (serverless safe)
dependencies = [
    "setuptools",
    "pyyaml==6.0.2",
    "jinja2==3.1.6",
    "python_benedict==0.34.1",
    "pandas==2.3.0",
    "toml==0.10.2",
    "loguru>=0.7.3",
    "mlflow>=3.7.0",
    "{{ ds_project }}",
    "joblib>=1.5.3",
    "databricks-feature-engineering>=0.13.0.1",
]

[project.urls]
Homepage = "https://blackstraw.ai/"

[tool.setuptools]
package-dir = { "" = "src" }
include-package-data = true

[tool.setuptools.packages.find]
where = ["src"]

[tool.uv.sources]
{{ ds_project | replace('_', '-') }} = { path = "ds_backend/{{ ds_project }}-1.0.0-py3-none-any.whl" }

[dependency-groups]
dev = [
    "pytest>=9.0.1",
    "pytest-mock==3.14.1",
    "pyspark==3.5.3",
    "delta-spark==3.2.1",
    "ruff>=0.14.7",
    "notebook>=7.5.0",
]
