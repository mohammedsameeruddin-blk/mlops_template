# =============================================================================
# TRAIN/TEST SPLIT CONFIG — training pipeline
# =============================================================================
# This step merges one or more feature tables into a single DataFrame and
# splits it into train and test sets. The output CSVs are consumed by train.yml.
#
# Data source — choose ONE mode and leave the other commented out:
#
#   databricks_table (default / recommended)
#     Reads feature data directly from the Databricks Feature Store at the
#     exact Delta version that was recorded during featurization (pinned via
#     MLflow params). This guarantees point-in-time correctness.
#
#   file (alternative)
#     Reads from the CSV files written to Volumes by featurization.yml.
#     Useful if you want to skip Feature Store and work with local files only.
#     Uncomment the file: block and comment out the databricks_table: block.
#
# TODO: Replace <merge_key> with the column name used to join feature tables
#       when merging multiple feature sources. Must be present in every table.
#       Example: transaction_id  or  customer_id
#       Note: Only a single merge key is currently supported.
#
# TODO: Replace <target> under split.stratify with the label/target column name
#       for stratified splitting (keeps class proportions in train and test).
#       Set stratify to null to disable stratification (e.g., for regression).
# =============================================================================

version: '1.0'
stage: training
file: splitter.yml # same as current filename; do not change this
audit_table: "{% raw %}{{ env.AUDIT_TARGET_CATALOG }}.{{ env.AUDIT_TARGET_SCHEMA }}.{{ env.AUDIT_TARGET_TABLE }}{% endraw %}"
actions:
  - name: train_test_split
    enable: true
    functions:
      class_path: {{ project }}.common.data.data_splitter:DataOperations
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_data_split
        # Set to file if reading from Volumes CSVs instead of Feature Store.
        source_data_type: databricks_table
        target_data_type: file
        inputs:
          # --- FILE MODE (alternative) ---
          # Uncomment this block and comment out databricks_table below to read
          # feature CSVs from Volumes instead of the Feature Store.
          # file:
          #   features:
          #     # Add one entry per feature CSV if merging multiple sources.
          #     {{ dataset_keyword }}:
          #       data: /data/featurization/{{ dataset_keyword }}.csv
          #   merge:
          #     how: inner # inner | outer | left | right
          #     merge_on: <merge_key>
          #   split:
          #     test_size: 0.2
          #     random_state: 42
          #     stratify: <target>
          file:
            pipeline:
          # --- DATABRICKS TABLE MODE (default) ---
          # Reads features from the Feature Store at the pinned Delta version
          # recorded during featurization (ensures point-in-time consistency).
          databricks_table:
            features:
              # Add one entry per feature table if merging multiple sources.
              {{ dataset_keyword }}:
                # Must match the process_name used in featurization.yml.
                feature_run_name: {{ dataset_keyword }}_featurization
                feature_table: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.{{ dataset_keyword }}_features"
            merge:
              how: inner
              # TODO: Replace with the column name to join on (e.g., transaction_id).
              merge_on: <merge_key>
            split:
              test_size: 0.2
              random_state: 42
              # TODO: Replace with the label/target column name for stratified splitting.
              # Set to null to disable stratification (e.g., for regression tasks).
              stratify: <target>
        outputs:
          # currently supports file/databricks_table
          file:
            merged: /data/training/merged_features.csv
            train:  /data/training/train.csv
            test:   /data/training/test.csv
            pipeline:
          databricks_table:
