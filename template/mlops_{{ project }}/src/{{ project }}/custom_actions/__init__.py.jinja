# =============================================================================
# CUSTOM ACTIONS
# =============================================================================
# Add project-specific action classes here when the built-in scaffold steps
# do not cover a required step (e.g., post-processing, data quality gates,
# writing to external systems, custom notifications).
#
# HOW THE CALLING CONVENTION WORKS
# ----------------------------------
# Each pipeline script (data_preprocessing.py, train.py, etc.) loads an action
# class via class_path and calls it as:
#
#     instance = MyClass(config=func_kwargs, data=df)
#     result   = instance.run()
#
# Where `func_kwargs` is the entire `kwargs:` block from the YAML `functions:`
# section. Your class receives this as `config` and must read `config["outputs"]`
# to know where to write its result.
#
# HOW TO ADD A CUSTOM ACTION
# --------------------------
# Option A — add the class directly to this file.
# Option B — create a new .py file inside this custom_actions/ directory.
#
# Either way, reference it in any pipeline config YAML:
#
#   functions:
#     class_path: {{ project }}.custom_actions:MyClass          # Option A
#     class_path: {{ project }}.custom_actions.my_file:MyClass  # Option B
#     kwargs:
#       project_name: {{ project }}
#       process_name: my_step
#       source_data_type: file          # or databricks_table
#       target_data_type: file          # or databricks_table
#       inputs:
#         file:
#           data: /data/some/input.csv
#         databricks_table:
#       outputs:                        # REQUIRED — tells the class where to write
#         file:
#           data: /data/some/output.csv
#         databricks_table:
#
# The `outputs:` block is mandatory in the YAML kwargs. Without it the class
# does not know where to write its result.
#
# WHAT GOES HERE (examples)
# --------------------------
#   - Post-prediction transforms (e.g., applying business rules to scores)
#   - Custom data quality gates (fail the pipeline if a threshold is not met)
#   - Writing results to an external system (e.g., REST API, Cosmos DB)
#   - Custom notification steps
#
# WHAT DOES NOT GO HERE
# ----------------------
#   - Model training, evaluation, or hyperparameter tuning → belongs in {{ ds_project }}
#   - Preprocessing → belongs in {{ ds_project }}
#   - Generic data loading → use data_loader.py in common/data/

from __future__ import annotations

from loguru import logger


class BaseAction:
    """Base class for custom actions.

    The pipeline script instantiates the class as:
        instance = MyClass(config=func_kwargs, data=df)
        result   = instance.run()

    `config` is the full `functions.kwargs` dict from the YAML, which includes
    `inputs`, `outputs`, `source_data_type`, `target_data_type`, and any custom
    kwargs you define. Use `config["outputs"]` to resolve the write target.
    """

    def __init__(self, config: dict, data=None, **kwargs):
        self.config = config       # Full functions.kwargs dict from the YAML
        self.data = data           # Input DataFrame loaded by the pipeline script
        self.outputs = config.get("outputs", {})

    def run(self):
        raise NotImplementedError(
            f"{self.__class__.__name__} must implement run()"
        )


