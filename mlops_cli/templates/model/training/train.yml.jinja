# =============================================================================
# TRAINING CONFIG — {{ model }} model
# =============================================================================
# This config drives the four-action training sequence:
#   1. hyperparameter_tuning  → finds the best hyperparameters
#   2. model_evaluation       → cross-validates the model with best params
#   3. model_training         → trains the final model and registers it
#   4. log_experiment_details → writes a tracking record to Delta
#
# TODO: Replace every <ds_project> placeholder with the actual DS package name.
#       This is the package installed from the wheel in ds_backend/.
#       Example: replace <ds_project> with fraud_ds
#
# The DS team needs to implement:
#   - HyperparameterTuner  (run() → logs all trials to MLflow, returns best params)
#   - ModelEvaluator       (run() → logs cross-validation metrics to MLflow)
#   - ModelTrainer         (run() → returns a trained sklearn-compatible model)
#
# TODO: Set include_model_explainability to false if the DS model does not support
#       SHAP-based explanations (e.g., some neural network architectures).
# =============================================================================

version: '1.0'
stage: training
file: train.yml # same as current filename; do not change this
audit_table: "{% raw %}{{ env.AUDIT_TARGET_CATALOG }}.{{ env.AUDIT_TARGET_SCHEMA }}.{{ env.AUDIT_TARGET_TABLE }}{% endraw %}"
actions:
  - name: hyperparameter_tuning
    enable: true
    functions:
      # TODO: Replace <ds_project> with the actual DS package name.
      # DS team implements: run() → logs all trials as nested MLflow runs, returns best params dict.
      class_path: <ds_project>.models.{{ model }}.training.hypertuning.tuner:HyperparameterTuner
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_hypertuning
        source_data_type: file
        inputs:
          # currently supports file/databricks_table
          file:
            train:
              data: /data/training/train.csv
            test:
              data: /data/training/test.csv
            # Leave pipeline empty if the featurization pipeline is not needed at tuning time.
            pipeline:
          databricks_table:

  - name: model_evaluation
    enable: true
    functions:
      # TODO: Replace <ds_project> with the actual DS package name.
      # DS team implements: run() → logs cross-validation metrics to MLflow.
      # Metrics logged: accuracy, precision, recall, roc_auc (classification)
      #                 or MAE, R², MSE, MAPE (regression).
      class_path: <ds_project>.models.{{ model }}.training.evaluation.selector:ModelEvaluator
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_evaluation
        source_data_type: file
        inputs:
          # currently supports file/databricks_table
          file:
            train:
              data: /data/training/train.csv
            test:
              data: /data/training/test.csv
            pipeline:
          databricks_table:

  - name: model_training
    enable: true
    functions:
      # TODO: Replace <ds_project> with the actual DS package name.
      # DS team implements: run() → returns a trained sklearn-compatible model.
      # The scaffold registers the model in Unity Catalog with the @challenger alias
      # and optionally generates 4 SHAP explainability plots.
      class_path: <ds_project>.models.{{ model }}.training.train:ModelTrainer
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_training
        source_data_type: file
        # Model registry path: <MODEL_CATALOG>.<MODEL_SCHEMA>.<model_name>
        model_registry_name: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.{{ model }}"
        # TODO: Set to false if the DS model does not support SHAP explainability.
        include_model_explainability: true
        inputs:
          # currently supports file/databricks_table
          file:
            train:
              data: /data/training/train.csv
            test:
              data: /data/training/test.csv
            # Path to the featurization pipeline .pkl — used to log it as an MLflow artifact.
            pipeline:
          databricks_table:

  - name: log_experiment_details
    # Writes an experiment tracking record to a Delta table for lineage queries.
    # No changes needed here unless you rename the experiment_tracking table.
    enable: true
    functions:
      class_path: {{ project }}.common.utils.io_utils:log_experiment_details
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_logging
        outputs:
          # currently supports databricks_table
          databricks_table: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.experiment_tracking"
