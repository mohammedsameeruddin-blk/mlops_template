import requests
from loguru import logger


def send_gchat_failure(
    webhook_url: str | None,
    environment: str,
    project: str,
    task: str,
    job_name: str,
    error_message: str,
    run_url: str,
):
    if webhook_url is None:
        logger.warning("No webhook URL provided, skipping Google Chat notification")
        return

    payload = {
        "cardsV2": [
            {
                "cardId": "error_failure",
                "card": {
                    "header": {
                        "title": "🚨 Databricks Job Failed",
                        "subtitle": f"Environment: {environment}",
                    },
                    "sections": [
                        {
                            "widgets": [
                                {
                                    "textParagraph": {
                                        "text": f"<b>Project:</b> {project}<br>"
                                        f"\n<b>Task:</b> {task}<br>"
                                        f"\n<b>Job:</b> {job_name}<br>"
                                        f"\n<b>Error:</b> {error_message}"
                                    }
                                }
                            ]
                        },
                        {
                            "widgets": [
                                {
                                    "buttonList": {
                                        "buttons": [
                                            {
                                                "text": "Open Run",
                                                "onClick": {
                                                    "openLink": {"url": run_url}
                                                },
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                    ],
                },
            }
        ]
    }

    response = requests.post(webhook_url, json=payload, timeout=10)
    response.raise_for_status()

    logger.info("🚨 Google Chat failure alert sent successfully")


def send_gchat_inference_success(
    webhook_url: str | None,
    environment: str,
    project: str,
    models: dict,
    job_name: str,
