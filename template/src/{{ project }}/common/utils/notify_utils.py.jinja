def send_gchat_drift_summary(
    webhook_url: str | None,
    environment: str,
    project: str,
    model_summaries: dict,
    drifted_models: list,
    drift_types: list,
    job_name: str,
    run_url: str,
    experiment_url: str | None = None,
):
    if webhook_url is None:
        logger.warning("No webhook URL provided, skipping Google Chat notification")
        return

    has_any_drift = bool(drifted_models)
    title = "⚠️ Drift Detected" if has_any_drift else "✅ No Drift Detected"

    models_bullets = ""
    for model, info in model_summaries.items():
        if isinstance(info, dict):
            if info["has_drift"]:
                types = (
                    ", ".join(info["drift_types"]) if info["drift_types"] else "drift"
                )
                severity = info["top_severity"]
                models_bullets += f"• <i>{model} → {types} [{severity}]</i><br>"
            else:
                models_bullets += f"• <i>{model} → no drift</i><br>"
        else:
            models_bullets += f"• <i>{model} → {info}</i><br>"

    buttons = [{"text": "Open Run", "onClick": {"openLink": {"url": run_url}}}]
    if experiment_url:
        buttons.append(
            {
                "text": "Open Experiment",
                "onClick": {"openLink": {"url": experiment_url}},
            }
        )

    payload = {
        "cardsV2": [
            {
                "cardId": "drift_summary",
                "card": {
                    "header": {
                        "title": title,
                        "subtitle": f"Environment: {environment}",
                    },
                    "sections": [
                        {
                            "widgets": [
                                {
                                    "textParagraph": {
                                        "text": f"<b>Project:</b> {project}<br>"
                                        f"\n<b>Models Summary:</b><br>"
                                        f"{models_bullets}"
                                        f"\n<b>Job:</b> {job_name}<br>"
                                        f"\n<b>Status:</b> SUCCESS"
                                    }
                                }
                            ]
                        },
                        {"widgets": [{"buttonList": {"buttons": buttons}}]},
                    ],
                },
            }
        ]
    }

    response = requests.post(webhook_url, json=payload, timeout=10)
    response.raise_for_status()
    icon = "⚠️" if has_any_drift else "✅"
    logger.info(f"{icon} Google Chat drift summary sent successfully")
