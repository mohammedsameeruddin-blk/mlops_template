# =============================================================================
# RETRAINING CONFIG — {{ model }} model
# =============================================================================
# IMPORTANT: This config intentionally skips hyperparameter_tuning and
# model_evaluation. During retraining the scaffold automatically reads
# best_model_params.json from the ORIGINAL training run's MLflow artifacts
# and passes those params directly to ModelTrainer — no re-tuning needed.
#
# When is retraining triggered?
#   Automatically by drift_monitoring/evaluate.yml when auto_trigger.enable
#   is set to true and the number of drifted models >= min_drifted_models.
#   Can also be triggered manually by running wf_{{ project }}_retraining.
#
# What is different from training/train.yml?
#   - stage_name is "retraining" (controls param-loading behaviour in train.py)
#   - Only model_training and log_experiment_details actions run
#   - The trained model is registered with @challenger, same as initial training
#
# TODO: Review class_path and include_model_explainability — these should match
#       what is set in training/{{ model }}/train.yml.
# =============================================================================

version: '1.0'
stage: retraining
file: train.yml # same as current filename; do not change this
audit_table: "{% raw %}{{ env.AUDIT_TARGET_CATALOG }}.{{ env.AUDIT_TARGET_SCHEMA }}.{{ env.AUDIT_TARGET_TABLE }}{% endraw %}"
actions:
  - name: model_training
    # Reuses the best hyperparameters from the last training run (loaded from
    # best_model_params.json in the training MLflow artifacts). The model is
    # trained on the fresh data produced by the retraining featurization step
    # and registered in the MLflow registry with the @challenger alias.
    enable: true
    functions:
      class_path: {{ ds_project }}.models.{{ model }}.training.train:ModelTrainer
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_training
        source_data_type: file
        model_registry_name: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.{{ model }}"
        # TODO: Set to false if the DS model does not support SHAP explainability.
        # Must match the value set in training/{{ model }}/train.yml.
        include_model_explainability: true
        inputs:
          # currently supports file/databricks_table
          file:
            train:
              data: /data/training/train.csv
            test:
              data: /data/training/test.csv
            pipeline:
          databricks_table:

  - name: log_experiment_details
    # Writes a retraining experiment record to the tracking Delta table.
    # No changes needed here.
    enable: true
    functions:
      class_path: {{ project }}.common.utils.io_utils:log_experiment_details
      kwargs:
        project_name: {{ project }}
        process_name: {{ model }}_logging
        outputs:
          # currently supports databricks_table
          databricks_table: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.experiment_tracking"
