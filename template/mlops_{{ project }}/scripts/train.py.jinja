import argparse
import importlib
import mlflow
import os
import json
import joblib
import pandas as pd
from mlflow.models import infer_signature
from datetime import datetime
from pathlib import Path

from loguru import logger
from pyspark.sql import SparkSession
from pyspark.dbutils import DBUtils

from {{ project }}.common.utils.config_utils import (
    load_project_config, 
    load_task_config
)
from {{ project }}.common.utils.audit_utils import write_to_audit_table


def load_class(class_path: str):
    module_path, class_name = class_path.split(":")
    module = importlib.import_module(module_path)
    return getattr(module, class_name)


def main(spark):
    parser = argparse.ArgumentParser()

    parser.add_argument("--root_path", required=True)
    parser.add_argument("--runtime_env", required=True)
    parser.add_argument("--yml_task", required=True)
    parser.add_argument("--project_name", required=True)
    parser.add_argument("--model_name", required=True)
    parser.add_argument("--stage_name", required=True)
    parser.add_argument("--task_key", required=True)
    parser.add_argument("--task_run_id", required=True)
    parser.add_argument("--job_name", required=True)
    parser.add_argument("--job_id", required=True)
    parser.add_argument("--job_run_id", required=True)
    parser.add_argument("--experiment_id", required=True)

    args = parser.parse_args()
    root_path = args.root_path
    runtime_env = args.runtime_env.lower()
    yml_task = args.yml_task
    project_name = args.project_name
    model_name = args.model_name
    stage_name = args.stage_name
    task_key = args.task_key
    task_run_id = args.task_run_id
    job_name = args.job_name
    job_id = args.job_id
    job_run_id = args.job_run_id
    experiment_id = args.experiment_id

    env_context = load_project_config(
        project_name=project_name,
        env_name=runtime_env,
    )

    task_config = load_task_config(
        project_name=project_name,
        model_name=model_name,
        stage_name=stage_name,
        env_context=env_context,
        which_file=yml_task,
    )
    placeholder_audit_table = f"hive_metastore.default.mlops_{project_name}_audit_tbl"
    audit_table = task_config.get("audit_table", placeholder_audit_table)
    if audit_table.startswith("."):
        logger.warning("`AUDIT_TARGET_CATALOG` is not specified in `config.toml`.")
        logger.info("Saving the audit details in `hive_metastore`.")
        audit_table = placeholder_audit_table

    with mlflow.start_run(
        run_name="training",
        experiment_id=experiment_id,
        nested=True
    ):
        actions_config = task_config.get("actions", [])
        for action in actions_config:
            if not action.get("enable", True):
                continue

            action_name = action["name"]
            func_conf = action["functions"]
            process_name = func_conf["kwargs"]["process_name"]
            cls = load_class(func_conf["class_path"])

            logger.info(f"Starting action: {action_name}")

            start_time = datetime.now()
            run_status = ""
            error_details = ""

            base_output_dir = os.path.join(root_path, stage_name)
            base_output_dir = Path(base_output_dir)

            with mlflow.start_run(
                run_name=action_name,
                experiment_id=experiment_id,
                nested=True
            ):
                try:
                    func_kwargs = func_conf["kwargs"]

                    if action_name == "train_test_split":
                        target_type = func_kwargs.get("target_data_type")
                        target_info = func_kwargs["outputs"]["file"]
                        source_type = func_kwargs["source_data_type"]
                        data_ops = cls(
                            spark=spark, func_conf=func_conf, source_type=source_type, root_path=root_path, stage_name=stage_name, experiment_id=experiment_id
                        )
                        result = data_ops.split_data()
                        merged_df, train_df, test_df, feature_params = result["merged"], result["train"], result["test"], result["params"]

                        if feature_params:
                            logger.debug(feature_params)
                            mlflow.log_param(key="features_info", value=json.dumps(feature_params))
                    
                        if target_type == "file":
                            # TODO: output should always be csv, but we can extend this later
                            merged_output_dir = "/".join(target_info["merged"].split("/")[:-1]).lstrip("/")
                            merged_output_path = base_output_dir / merged_output_dir
                            merged_output_path.mkdir(parents=True, exist_ok=True)
                            merged_data_path = base_output_dir / target_info["merged"].lstrip("/")
                            logger.info(f"Writing merged data output to {merged_output_path}")
                            mlflow.log_param(key=f"target_merged_file_path", value=merged_data_path)
                            merged_df.to_csv(merged_data_path, index=False)

                            train_output_dir = "/".join(target_info["train"].split("/")[:-1]).lstrip("/")
                            train_output_path = base_output_dir / train_output_dir
                            train_output_path.mkdir(parents=True, exist_ok=True)
                            train_data_path = base_output_dir / target_info["train"].lstrip("/")
                            logger.info(f"Writing train data output to {train_output_path}")
                            mlflow.log_param(key=f"target_train_file_path", value=train_data_path)
                            train_df.to_csv(train_data_path, index=False)

                            test_output_dir = "/".join(target_info["test"].split("/")[:-1]).lstrip("/")
                            test_output_path = base_output_dir / test_output_dir
                            test_output_path.mkdir(parents=True, exist_ok=True)
                            test_data_path = base_output_dir / target_info["test"].lstrip("/")
                            logger.info(f"Writing test data output to {test_output_path}")
                            mlflow.log_param(key=f"target_test_file_path", value=test_data_path)
                            test_df.to_csv(test_data_path, index=False)
                    
                    if action_name == "hyperparameter_tuning":
                        source_info = func_kwargs["inputs"]["file"]
                        train_data_path = base_output_dir / source_info["train"]["data"].lstrip('/')
                        train_df = pd.read_csv(filepath_or_buffer=train_data_path, sep=",")

                        hyper_obj = cls(train_df=train_df)
                        tuning_results = hyper_obj.run()
                        for mname, result in tuning_results.items():
                            with mlflow.start_run(
                                run_name=f"{mname}_hyperopt",
                                experiment_id=experiment_id,
                                nested=True
                            ) as model_run:

                                # Best params of the model after all the trials
                                mlflow.log_params(params=result["best_params"])
                                mlflow.log_metric(key="best_loss", value=result["best_loss"])

                                # Log the trial-based metrics and params
                                for idx, trial in enumerate(result["trials"], start=1):
                                    with mlflow.start_run(
                                        run_name=f"{mname}_trial_{idx}",
                                        experiment_id=experiment_id,
                                        nested=True
                                    ):
                                        mlflow.log_params(params=trial["params"])
                                        mlflow.log_metrics(metrics=trial["metrics"])
                                        mlflow.log_metric(key="loss", value=trial["loss"])
                                        mlflow.set_tag(key="status", value=trial["status"])
                        
                        tuning_results_path = base_output_dir / "hyperparameter_results.json"
                        tuning_results_path.parent.mkdir(parents=True, exist_ok=True)
                        with open(tuning_results_path, "w") as f:
                            json.dump(tuning_results, f, indent=2)
                        mlflow.log_artifact(local_path=str(tuning_results_path))
                    
                    if action_name == "model_evaluation":
                        source_info = func_kwargs["inputs"]["file"]
                        train_data_path = base_output_dir / source_info["train"]["data"].lstrip('/')
                        train_df = pd.read_csv(filepath_or_buffer=train_data_path, sep=",")
                        # TODO: read from hyper results from experiment not from the bundle path
                        tuning_results_path = base_output_dir / "hyperparameter_results.json"
                        if not tuning_results_path.exists():
                            raise FileNotFoundError("Hyperparameter tuning results not found")

                        with open(tuning_results_path) as f:
                            tuning_results = json.load(f)

                        evaluator = cls(train_df=train_df, tuning_results=tuning_results)
                        evaluation_results = evaluator.run()
                        for mname, result in evaluation_results["models"].items():
                            with mlflow.start_run(
                                run_name=f"{mname}_evaluation",
                                experiment_id=experiment_id,
                                nested=True
                            ) as model_run:
                                
                                # Best params of the model after all the trials
                                mlflow.log_params(params=result["best_params"])
                                mlflow.log_metrics(metrics=result["mean_metrics"])

                                mproblem_type = result["model_type"]

                                # Log the trial-based metrics and params
                                for fold in result["folds"]:
                                    with mlflow.start_run(
                                        run_name=f"{mname}_fold_{fold['fold']}",
                                        experiment_id=experiment_id,
                                        nested=True
                                    ):
                                        if mproblem_type == "classification":
                                            mlflow.log_metrics(metrics={
                                                "accuracy": fold["accuracy"],
                                                "precision": fold["precision"],
                                                "recall": fold["recall"],
                                                "roc_auc": fold["roc_auc"],
                                            })
                                        else:
                                            mlflow.log_metrics(metrics={
                                                "mae": fold["mae"],
                                                "r2": fold["r2"],
                                                "mse": fold["mse"],
                                                "mape": fold["mape"],
                                            })
                        
                        mlflow.log_param(key="best_model", value=evaluation_results["best_model"])
                        mlflow.log_param(key="selection_metric", value=evaluation_results["selection_metric"])
                        mlflow.log_param(key="selection_value", value=evaluation_results["selection_value"])
                        mlflow.set_tag(key="status", value="success")
                        
                        # log best_model_params artifact
                        best_model_name = evaluation_results["best_model"]
                        best_model_params = {
                            best_model_name: evaluation_results["models"][best_model_name]["best_params"]
                        }
                        best_model_params_path = base_output_dir / "best_model_params.json"
                        best_model_params_path.parent.mkdir(parents=True, exist_ok=True)
                        with open(best_model_params_path, "w") as f:
                            json.dump(best_model_params, f, indent=2)
                        mlflow.log_artifact(local_path=str(best_model_params_path))
                
                    if action_name == "model_training":
                        source_info = func_kwargs["inputs"]["file"]
                        train_data_path = base_output_dir / source_info["train"]["data"].lstrip('/')
                        test_data_path = base_output_dir / source_info["test"]["data"].lstrip('/')
                        train_df = pd.read_csv(filepath_or_buffer=train_data_path, sep=",")
                        test_df = pd.read_csv(filepath_or_buffer=test_data_path, sep=",")
                        # TODO: read from best_model_params results from experiment not from the bundle path
                        best_model_params_path = base_output_dir / "best_model_params.json"
                        if not best_model_params_path.exists():
                            raise FileNotFoundError("Best model results not found")

                        with open(best_model_params_path) as f:
                            best_model_params = json.load(f)
                        
                        best_model_name = list(best_model_params.keys())[0]
                        best_params = best_model_params[best_model_name]
                        trainer = cls(
                            train_df=train_df,
                            test_df=test_df,
                            model_name=best_model_name,
                            best_params=best_params
                        )
                        model_results = trainer.run()

                        # Train metrics
                        with mlflow.start_run(
                            run_name="train_metrics",
                            experiment_id=experiment_id,
                            nested=True
                        ):
                            mlflow.log_metrics(model_results["metrics"]["train"])
                        
                        # Test metrics
                        with mlflow.start_run(
                            run_name="test_metrics",
                            experiment_id=experiment_id,
                            nested=True
                        ):
                            mlflow.log_metrics(model_results["metrics"]["test"])
                        
                        artifacts_dir = base_output_dir / "model_artifacts"
                        artifacts_dir.mkdir(parents=True, exist_ok=True)
                        # Log best params
                        params_path = artifacts_dir / "best_model_params.json"
                        with open(params_path, "w") as f:
                            json.dump(best_model_params, f, indent=2)
                        mlflow.log_artifact(local_path=str(params_path))
                        # Log and register best model
                        X_sample = model_results["input_example"]
                        if model_results["model_type"] == "classification":
                            y_sample = model_results["model"].predict_proba(X_sample)[:, 1]
                        else:
                            y_sample = model_results["model"].predict(X_sample)
                        signature = infer_signature(
                            model_input=X_sample,
                            model_output=y_sample
                        )
                        mlflow.sklearn.log_model(
                            sk_model=model_results["model"],
                            artifact_path="model",
                            registered_model_name=func_kwargs["model_registry_name"],
                            signature=signature,
                            input_example=X_sample
                        )
                        
                        # Log scaler artifact
                        scaler_path = artifacts_dir / "scaler.pkl"
                        joblib.dump(model_results["scaler"], scaler_path)
                        mlflow.log_artifact(
                            local_path=scaler_path,
                            artifact_path="model/scaler"
                        )
                        mlflow.log_param(key="scalar", value=scaler_path)

                        # Log feature pipelines artifacts together
                        feature_pipelines_logs = func_kwargs["feature_pipelines"]
                        for tdata, pipeline in feature_pipelines_logs.items():
                            pipeline_full_path = base_output_dir / pipeline["pipeline"].lstrip("/")
                            mlflow.log_artifact(
                                local_path=pipeline_full_path,
                                artifact_path=f"model/featurization/"
                            )
                        
                        # Log feature pipelines metadata
                        mlflow.log_param(
                            key="feature_pipelines",
                            value=json.dumps({
                                k: v["pipeline"] for k, v in feature_pipelines_logs.items()
                            })
                        )
                    
                    run_status = "SUCCESS"
                except Exception as e:
                    run_status = "FAILED"
                    error_details = str(e)
                    logger.error(f"Action failed: {action_name}")
                    raise

                finally:
                    end_time = datetime.now()
                    duration_minutes = round((end_time - start_time).total_seconds() / 60, 2)

                    mlflow.log_metric("duration_minutes", duration_minutes)
                    mlflow.set_tag("run_status", run_status)

                    audit_metrics = dict(
                        project_name=project_name,
                        model_name=model_name,
                        stage_name=stage_name,
                        task_name=task_key,
                        process_name=process_name,
                        task_run_id=task_run_id,
                        job_name=job_name,
                        job_id=job_id,
                        job_run_id=job_run_id,
                        run_status=run_status,
                        start_time=str(start_time),
                        end_time=str(end_time),
                        duration_mins=str(duration_minutes),
                        error_details=error_details
                    )
                    logger.info(
                        f"Action {action_name} finished | Status={run_status} | Duration={duration_minutes} min"
                    )
                    write_to_audit_table(spark, audit_metrics, func_conf, audit_table)

    logger.success("Model training completed successfully.")
    return experiment_id


if __name__ == "__main__":
    spark = SparkSession.builder.getOrCreate()
    dbutils = DBUtils(spark)
    
    experiment_id = main(spark=spark)
    dbutils.jobs.taskValues.set(key="experiment_id", value=experiment_id)
