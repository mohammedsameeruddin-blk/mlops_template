# change as per the requirement

version: '1.0'
stage: training
file: preprocess.yml # same as current filename; do not change this
audit_table: "{% raw %}{{ env.AUDIT_TARGET_CATALOG }}.{{ env.AUDIT_TARGET_SCHEMA }}.{{ env.AUDIT_TARGET_TABLE }}{% endraw %}"
actions:
  - name: data_preprocessing
    enable: true
    functions:
      class_path: <data_science_module_file_path>
      kwargs:
        project_name: {{ project }}
        model_name: {{ model }}
        process_name: {{ model }}_preprocess
        source_data_type: databricks_table
        target_data_type: file
        inputs:
          # currently supports file/databricks_table
          file:
            data:
            pipeline:
          databricks_table: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.<table>"
        outputs:
          # currently supports file/databricks_table
          file:
            data: /data/preprocessing/<data>.csv
            pipeline:
          databricks_table: