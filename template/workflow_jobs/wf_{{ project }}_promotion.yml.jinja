resources:
  jobs:
    promotion:
      name: mlops_{{ project }}_promotion
      tags:
        project_name: "{{ project }}"

      environments:
        - environment_key: default
          spec:
            client: "3"
            dependencies:
              - "../${var.data_science_project_library}"
              - "../${var.mlops_project_library}"

      tasks:
        - task_key: start_setup
          environment_key: default
          spark_python_task:
            python_file: ../scripts/start_setup.py
            parameters:
              - --root_path
              - ${workspace.root_path}
              - --runtime_env
              - ${var.run_time_env}
              - --yml_task
              - start.yml
              - --project_name
              - "{{ project }}"
              - --model_name
              - none
              - --stage_name
              - promotion
              - --task_key
              - '{% raw %}{{task.name}}{% endraw %}' # do not change this
              - --task_run_id
              - '{% raw %}{{task.run_id}}{% endraw %}' # do not change this
              - --job_name
              - '{% raw %}{{job.name}}{% endraw %}' # do not change this
              - --job_id
              - '{% raw %}{{job.id}}{% endraw %}' # do not change this
              - --job_run_id
              - '{% raw %}{{job.run_id}}{% endraw %}' # do not change this

        - task_key: {{ model }}_promotion
          depends_on:
            - task_key: start_setup
          environment_key: default
          spark_python_task:
            python_file: ../scripts/promote_serving.py
            parameters:
              - --root_path
              - ${workspace.root_path}
              - --runtime_env
              - ${var.run_time_env}
              - --yml_task
              - promotion.yml
              - --project_name
              - "{{ project }}"
              - --model_name
              - "{{ model }}"
              - --stage_name
              - promotion
              - --task_key
              - '{% raw %}{{task.name}}{% endraw %}' # do not change this
              - --task_run_id
              - '{% raw %}{{task.run_id}}{% endraw %}' # do not change this
              - --job_name
              - '{% raw %}{{job.name}}{% endraw %}' # do not change this
              - --job_id
              - '{% raw %}{{job.id}}{% endraw %}' # do not change this
              - --job_run_id
              - '{% raw %}{{job.run_id}}{% endraw %}' # do not change this
              - --experiment_id
              - '{% raw %}{{tasks.start_setup.values.experiment_id}}{% endraw %}'

        - task_key: end_setup
          depends_on:
            - task_key: {{ model }}_promotion
          environment_key: default
          spark_python_task:
            python_file: ../scripts/end_setup.py
            parameters:
              - "--root_path"
              - ${workspace.root_path}
              - --runtime_env
              - "${var.run_time_env}"
              - --yml_task
              - "end.yml"
              - --project_name
              - "{{ project }}"
              - --model_name
              - "none"
              - --stage_name
              - "promotion"
              - --task_key
              - '{% raw %}{{task.name}}{% endraw %}' # do not change this
              - --task_run_id
              - '{% raw %}{{task.run_id}}{% endraw %}' # do not change this
              - --job_name
              - '{% raw %}{{job.name}}{% endraw %}' # do not change this
              - --job_id
              - '{% raw %}{{job.id}}{% endraw %}' # do not change this
              - --job_run_id
              - '{% raw %}{{job.run_id}}{% endraw %}' # do not change this
              - --experiment_id
              - '{% raw %}{{tasks.{% endraw %}{{ model }}{% raw %}_promotion.values.experiment_id}}{% endraw %}'
              - --models_promoted
              - '{{ model }}'
