# =============================================================================
# PREPROCESSING CONFIG — inference pipeline
# =============================================================================
# This step applies the same preprocessing logic as the training pipeline,
# but to incoming (unlabelled) inference data.
#
# TODO: Replace <data_science_module_file_path> with the same class path used
#       in training/preprocess.yml — the preprocessing class must handle both
#       training and inference data without fitting (stateless transforms only,
#       or load a previously fitted preprocessor artifact if needed).
#       Format: <package>.<module>.<submodule>:<ClassName>
#       Example: {{ ds_project }}.preprocessing.pipeline:DataPreprocessor
#
# Input:  _incoming_raw_data table written by inference/data.yml
# Output: _incoming.csv consumed by inference/featurization.yml
# =============================================================================

version: '1.0'
stage: inference
file: preprocess.yml # same as current filename; do not change this
audit_table: "{% raw %}{{ env.AUDIT_TARGET_CATALOG }}.{{ env.AUDIT_TARGET_SCHEMA }}.{{ env.AUDIT_TARGET_TABLE }}{% endraw %}"
actions:
  - name: {{ dataset_keyword }}_preprocessing
    enable: true
    functions:
      # TODO: Replace with the DS project's preprocessing class path.
      # Must match the class used in training/preprocess.yml.
      class_path: <data_science_module_file_path>
      kwargs:
        project_name: {{ project }}
        process_name: {{ dataset_keyword }}_preprocess
        source_data_type: databricks_table
        target_data_type: file
        inputs:
          # currently supports file/databricks_table
          file:
            data:
            pipeline:
          # Reads from the incoming staging table written by inference/data.yml.
          databricks_table: "{% raw %}{{ env.MODEL_CATALOG_SCHEMA }}{% endraw %}.{{ dataset_keyword }}_incoming_raw_data"
        outputs:
          # currently supports file/databricks_table
          file:
            # Cleaned CSV — consumed by inference/featurization.yml.
            data: /data/preprocessing/{{ dataset_keyword }}_incoming.csv
            pipeline:
          databricks_table:
